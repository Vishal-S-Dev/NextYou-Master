
. "$(dirname "$0")/common.sh"

# Fix missing PATH when used in GUI/IDE or non-login shell
#export PATH="/Users/admin/.nvm/versions/node/v22.9.0/bin:$PATH"
export PATH="$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node | tail -1)/bin:$PATH"

echo "===\n>> Checking branch name..."


# Check if HEAD exists (i.e., repo has at least one commit)
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  # Check if branch protection is enabled
  if [[ -z $SKIP_BRANCH_PROTECTION ]]; then
      BRANCH=$(git rev-parse --abbrev-ref HEAD)
      PROTECTED_BRANCHES="^(main|master)"

      if [[ $BRANCH =~ $PROTECTED_BRANCHES ]]; then
          echo ">> Direct commits to the $BRANCH branch are not allowed. Please choose a new branch name."
          exit 1
      fi
  else
      echo ">> Skipping branch protection."
  fi
else
    echo ">> HEAD does not exist yet (likely first commit) — skipping branch protection check."
fi
echo ">> Finish checking branch name"
echo ">> Linting your files and fixing them if needed..."

pnpm type-check
pnpm lint-staged